{
  "name": "irudd-plan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run build:server && vp run build:client",
    "build:client": "vp build --config vite.client.config.ts",
    "build:server": "vp build",
    "check": "vp check",
    "check:ci": "vp fmt --check && vp lint --quiet",
    "dev": "vp run build:client && tsx watch src/server/main.ts",
    "db:generate": "drizzle-kit generate",
    "example:mcp": "tsx scripts/mcp-example.ts examples/plan.json",
    "start": "node dist/main.js",
    "test": "vp test",
    "test:browser": "playwright test",
    "test:browser:server": "tsx tests/browser-server.ts",
    "preflight:mcp": "tsx scripts/mcp-preflight.ts",
    "example:database": "tsx scripts/effect-drizzle-example.ts",
    "skill:install": "bash scripts/install-skill.sh",
    "smoke:browser": "playwright test --config playwright.smoke.config.ts",
    "trial:codex": "tsx scripts/codex-trial.ts",
    "smoke:mcp": "tsx scripts/mcp-auth-smoke.ts"
  },
  "dependencies": {
    "@effect/sql-sqlite-node": "4.0.0-rc.112",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@radix-ui/react-slot": "^1.3.3",
    "acorn": "^8.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "effect": "4.0.0-rc.112",
    "jose": "6.2.10",
    "lucide-react": "^1.41.0",
    "parse5": "^8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ses": "^2.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0"
  },
  "engines": {
    "node": "24.20.0",
    "pnpm": "11.25.0"
  },
  "packageManager": "pnpm@11.25.0"
}
