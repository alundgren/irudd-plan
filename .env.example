# Non-secret template. Replace placeholders before starting the production server.
DATABASE_PATH=./data/irudd-plan.db
MIGRATIONS_DIR=./drizzle
REQUEST_BODY_LIMIT_BYTES=12000000
MAX_ASSET_BYTES=5000000
MAX_ASSET_SOURCE_BYTES=2000000
MAX_OWNER_ASSET_STORAGE_BYTES=100000000
CLIENT_ASSETS_DIR=./dist/client/assets
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=https://plans.example.com
CF_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
CF_ACCESS_JWKS_URL=https://your-team.cloudflareaccess.com/cdn-cgi/access/certs
CF_ACCESS_AUDIENCE=replace-with-mcp-application-audience
CF_ACCESS_BROWSER_AUDIENCE=replace-with-browser-application-audience
OWNER_MAPPINGS_JSON='[{"issuer":"https://your-team.cloudflareaccess.com","claim":"common_name","value":"replace-with-service-client-id","kind":"service","ownerId":"owner-a"},{"issuer":"https://your-team.cloudflareaccess.com","claim":"email","value":"owner@example.com","kind":"browser","ownerId":"owner-a"}]'
# GitHub settings are optional as a group until linking/publication is needed.
# GITHUB_APP_ID=replace-with-numeric-app-id
# Keep the single quotes when this line is used in a systemd EnvironmentFile.
# GITHUB_APP_PRIVATE_KEY='replace-with-PEM-using-literal-\n-between-lines'
# OWNER_GITHUB_INSTALLATIONS_JSON='[{"ownerId":"owner-a","installationId":123456,"repositories":[{"owner":"example","name":"project"}]}]'
