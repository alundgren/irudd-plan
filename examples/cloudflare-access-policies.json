{
  "hostname": "plans.example.com",
  "applications": [
    {
      "name": "irudd-plan public reads",
      "path": "/public/*",
      "policy": "Bypass"
    },
    {
      "name": "irudd-plan MCP",
      "path": "/mcp",
      "policy": "Service Auth"
    },
    {
      "name": "irudd-plan private browser",
      "path": "/*",
      "policy": "One-time PIN"
    }
  ],
  "originChecks": {
    "anonymous": [
      "/public/plans/{ownerId}/{planId}",
      "/public/plans/{ownerId}/{planId}/items/{itemId}",
      "/public/plans/{ownerId}/{planId}/document",
      "/public/plans/{ownerId}/{planId}/assets/{assetId}?digest={digest}",
      "/public/plans/{ownerId}/{planId}/events",
      "/public/assets/*"
    ],
    "accessIdentityRequired": ["/", "/plans/*", "/api/*", "/mcp"]
  }
}
