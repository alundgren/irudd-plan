HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/irudd-plan.db
MIGRATIONS_DIR=./drizzle
REQUEST_BODY_LIMIT_BYTES=2000000
CF_ACCESS_ISSUER=https://example.cloudflareaccess.com
CF_ACCESS_AUDIENCE=replace-with-access-application-aud
CF_ACCESS_JWKS_URL=https://example.cloudflareaccess.com/cdn-cgi/access/certs
OWNER_MAPPINGS_JSON=[{"issuer":"https://example.cloudflareaccess.com","claim":"common_name","value":"replace-with-service-token-name","kind":"service","ownerId":"owner-1"},{"issuer":"https://example.cloudflareaccess.com","claim":"email","value":"person@example.com","kind":"browser","ownerId":"owner-1"}]
